{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate-check.sh",
            "timeout": 600
          },
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate-check.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
