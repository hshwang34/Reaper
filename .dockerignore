# Build context for the root Dockerfile (the image needs shared/, core/, web/
# and server/). Never ship secrets or local state; without this the context
# was 3.4 GB (node_modules, packaged installers, worktrees).
.env
.env.*
**/settings.json
server/data.sqlite*
server/uploads
server/safety
server/backups
sidecar/uploads
sidecar/safety

# Rebuilt inside the image / irrelevant to the server.
node_modules
**/node_modules
web/dist
app/release
app/build-resources
app/dist
site
docs
*.md
.git
.github
.claude
