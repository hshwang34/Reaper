# ── Decart ──────────────────────────────────────────────────────────────
# Permanent API key (dct_...). Lives ONLY in the sidecar; never shipped to a page.
# The sidecar mints short-lived ek_ client tokens from it per hijack job.
DECART_API_KEY=dct_replace_me

# ── Streamlabs ──────────────────────────────────────────────────────────
# Socket API token: Streamlabs Dashboard → Account Settings → API Settings →
# API Tokens → "Your Socket API Token". Enables the real donation trigger.
# Leave blank to run with only the fake-tip dev trigger.
STREAMLABS_SOCKET_TOKEN=

# ── OBS ─────────────────────────────────────────────────────────────────
# obs-websocket (OBS → Tools → WebSocket Server Settings). Blank password OK
# if you disabled auth. The router page connects to this.
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=
# Scene + Browser Source that displays the AI viewer page (toggled on/off).
OBS_SCENE=Scene
OBS_SOURCE=AI Hijack

# ── Content safety (docs/CONTENT-SAFETY.md) ────────────────────────────
# With a real Decart key, viewer-authored bytes only reach the model through
# classifiers. Missing keys switch the matching tier off — presets still work:
#   · custom text prompts need OPENAI_API_KEY (the moderation floor — it can't be
#     talked out of a verdict). ANTHROPIC_API_KEY adds the per-streamer policy
#     check on top; on its own it is not enough.
#   · ANY reference image (incl. "Become the Photo") needs Sightengine, the one
#     configured classifier that detects possible minors
# OpenAI's moderation endpoint is free — the floor check for text + images.
OPENAI_API_KEY=
# Per-streamer policy classifier (intensity / categories / public figures).
ANTHROPIC_API_KEY=
# Optional override; default claude-haiku-5-5.
RH_CLASSIFIER_MODEL=
# sightengine.com → API keys. Nudity + minors (face-age) + gore + offensive.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# ── Ports ───────────────────────────────────────────────────────────────
SIDECAR_PORT=7712
WEB_PORT=5173
